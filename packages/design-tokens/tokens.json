{
  "$description": "Single source of design tokens for apps/web (CSS + Tailwind) and apps/android (Compose). Edit here, then run `pnpm --filter @forge/design-tokens build`.",
  "color": {
    "dark": {
      "bg-canvas": "#0B1020",
      "bg-surface": "#111827",
      "bg-raised": "#161F33",
      "bg-field": "#1C2740",
      "border-subtle": "#24304A",
      "border-strong": "#3A4868",
      "text-primary": "#E6EAF2",
      "text-secondary": "#A3AECB",
      "text-muted": "#8391B0",
      "accent": "#5B97FF",
      "accent-strong": "#2F6FEB",
      "accent-violet": "#A78BFA",
      "on-accent": "#FFFFFF",
      "focus": "#7AA9FF",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "info": "#38BDF8"
    },
    "light": {
      "bg-canvas": "#F5F7FB",
      "bg-surface": "#FFFFFF",
      "bg-raised": "#EEF1F7",
      "bg-field": "#FFFFFF",
      "border-subtle": "#DDE2EC",
      "border-strong": "#AEB8CC",
      "text-primary": "#0F172A",
      "text-secondary": "#36415A",
      "text-muted": "#55617C",
      "accent": "#1D4ED8",
      "accent-strong": "#1D4ED8",
      "accent-violet": "#6D28D9",
      "on-accent": "#FFFFFF",
      "focus": "#2563EB",
      "success": "#15803D",
      "warning": "#A16207",
      "danger": "#B91C1C",
      "info": "#0369A1"
    }
  },
  "contrast": {
    "$description": "Pairs that must meet WCAG AA (4.5:1 for text) in both themes. Checked by `pnpm test`.",
    "minimum": 4.5,
    "pairs": [
      ["text-primary", "bg-canvas"],
      ["text-primary", "bg-surface"],
      ["text-primary", "bg-raised"],
      ["text-primary", "bg-field"],
      ["text-secondary", "bg-canvas"],
      ["text-secondary", "bg-surface"],
      ["text-secondary", "bg-raised"],
      ["text-muted", "bg-canvas"],
      ["text-muted", "bg-surface"],
      ["accent", "bg-canvas"],
      ["accent", "bg-surface"],
      ["on-accent", "accent-strong"],
      ["success", "bg-surface"],
      ["warning", "bg-surface"],
      ["danger", "bg-surface"],
      ["info", "bg-surface"]
    ]
  },
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "fontSize": { "tiny": 12, "caption": 13, "small": 14, "body": 15, "lead": 17, "section": 20, "title": 26, "code": 13 },
  "lineHeight": 1.45,
  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "sm": 4, "md": 6, "lg": 8, "xl": 12 },
  "elevation": {
    "$description": "0 flat, 1 card, 2 popover, 3 dialog. Values are CSS box-shadows; Compose uses the dp levels.",
    "0": { "shadow": "none", "dp": 0 },
    "1": { "shadow": "0 1px 2px rgb(0 0 0 / 0.30)", "dp": 1 },
    "2": { "shadow": "0 6px 16px rgb(0 0 0 / 0.35)", "dp": 3 },
    "3": { "shadow": "0 16px 40px rgb(0 0 0 / 0.45)", "dp": 6 }
  },
  "breakpoint": { "md": 768, "lg": 1280 }
}
